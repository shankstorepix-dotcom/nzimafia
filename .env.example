# ====================================================================
# NZI MAFIA — CONFIGURAÇÕES DE AMBIENTE & SUPABASE
# ====================================================================

# Porta do Servidor Express
PORT=3000

# Chave secreta JWT (Gere uma chave longa e segura, mínimo 32 caracteres)
JWT_SECRET=nzi_mafia_vault_token_777_dinheiro_primeiro_super_secure

# Chave secreta para setup inicial do primeiro administrador (caso o banco esteja sem Owner)
ADMIN_SETUP_SECRET=chave_secreta_super_forte_para_setup_inicial_nzi

# Origens autorizadas para CORS em produção (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000

# ====================================================================
# CREDENCIAIS DO SUPABASE (Obtenha em: https://supabase.com/dashboard)
# Acesse seu Projeto -> Project Settings -> API
# ====================================================================

# Project URL (Ex: https://xyzcompany.supabase.co)
SUPABASE_URL=https://vbnpspzivhaohmzviktm.supabase.co/rest/v1/

# Project API Anon Key (chave pública anônima)
SUPABASE_ANON_KEY=sb_publishable_wiqUTPJOvPOu8rF1bWL_8Q_pa5jy-d5

# Project API Service Role Key (chave secreta com permissão de escrita/banco)
# RECOMENDADO: utilize a SERVICE_ROLE_KEY no back-end para controle total de RLS
SUPABASE_SERVICE_ROLE_KEY=sb_secret_W0KL5NaoiiJuRuj96fa6jA_p4PTsoqm

# Alias opcional
SUPABASE_KEY=sua-chave-service-role-aqui

# ====================================================================
# RASTREAMENTO DE ACESSOS (página inicial do dashboard › "Acessos por estado")
# ====================================================================
# Provedor de geolocalização por IP (consultado SOMENTE pelo servidor):
#   auto    (padrão) usa IPinfo se IPINFO_TOKEN existir; senão usa ipwho.is (HTTPS, sem chave)
#   ipinfo  só IPinfo      |  ipwhois  só ipwho.is
#   off     não consulta ninguém (nenhum IP sai do servidor; acessos contam, mas sem estado/cidade)
GEO_PROVIDER=auto

# Token do IPinfo (https://ipinfo.io/signup) — opcional, mais preciso e com limites maiores.
IPINFO_TOKEN=

# Dias de retenção dos registros individuais (IP truncado). Mín. 7, máx. 365. Padrão: 90
# Os TOTAIS por estado são contadores sem dados pessoais e continuam acumulados.
TRACKING_RETENTION_DAYS=90

# Segredo do hash de visitante (HMAC). Se vazio, usa o JWT_SECRET.
TRACKING_HASH_SECRET=

# Atrás de proxy/CDN: número de proxies confiáveis (ex.: 1) para ler o IP real. Deixe vazio em localhost.
TRUST_PROXY=

# NÃO recomendado (LGPD/minimização): gravar o IP completo em vez do IP truncado.
TRACKING_STORE_FULL_IP=true
